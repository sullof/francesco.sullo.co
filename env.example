# PostgreSQL Database Configuration
# For production: use 'postgres' (container name from Docker link)
# For local development: use 'localhost'
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=hooq

# Application Configuration
NODE_ENV=production
PORT=9050

# Note: PostgreSQL uses Docker named volume 'postgres-data'
# Only create log directory: mkdir -p /vol/log/sullo-co_app
